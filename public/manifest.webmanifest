{
  "name": "Bitewise — Indian calorie & protein tracker",
  "short_name": "Bitewise",
  "description": "Track calories, protein and nutrition for Indian food with photo, voice and barcode logging.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#EDEFF5",
  "theme_color": "#2A3A8C",
  "categories": ["health", "food", "lifestyle"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Log by voice", "short_name": "Voice", "url": "/#voice", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Snap your thali", "short_name": "Photo", "url": "/#photo", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Scan a product", "short_name": "Scan", "url": "/#scan", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Search food", "short_name": "Add", "url": "/#add", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
