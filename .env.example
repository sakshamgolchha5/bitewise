# Copy to .env for local testing, or set these in Render. Never commit real keys.
# Google AI Studio creates the Gemini API key used by the server.
GEMINI_API_KEY=your-gemini-api-key
CONTACT_EMAIL=you@example.com
PORT=3000
# Conservative protection for a 20–30 person test. Gemini quotas are project-wide.
AI_LIMIT_PER_IP_PER_DAY=15
AI_LIMIT_PER_IP_PER_MIN=3
MODEL_VISION=gemini-2.5-flash-lite
MODEL_FAST=gemini-2.5-flash-lite
# Native (Capacitor) app origins allowed to call the API
ALLOWED_ORIGINS=capacitor://localhost,https://localhost,http://localhost
